      "TimeAlignment": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "easySoundFitModeEnabled": {
            "type": "boolean",
            "title": "Easysoundfitmodeenabled"
          },
          "easySoundFitMode": {
            "type": "integer",
            "title": "Easysoundfitmode"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "easySoundFitModeEnabled",
          "easySoundFitMode"
        ],
        "title": "TimeAlignment"
      },
      "TuningData": {
        "properties": {
          "foundationEq": {
            "$ref": "#/components/schemas/FoundationEq"
          },
          "speakers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Speaker"
            },
            "type": "object",
            "title": "Speakers"
          },
          "filter": {
            "$ref": "#/components/schemas/Filter"
          },
          "factoryCancel": {
            "$ref": "#/components/schemas/FactoryCancel"
          },
          "faderBalance": {
            "$ref": "#/components/schemas/FaderBalance"
          },
          "timeAlignment": {
            "$ref": "#/components/schemas/TimeAlignment"
          }
        },
        "type": "object",
        "required": [
          "foundationEq",
          "speakers",
          "filter",
          "factoryCancel",
          "faderBalance",
          "timeAlignment"
