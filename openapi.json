  "components": {
    "schemas": {
      "CancellingEq": {
        "properties": {
          "L": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "L"
          },
          "R": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "R"
          }
        },
        "type": "object",
        "required": [
          "L",
          "R"
        ],
        "title": "CancellingEq"
      },
      "CancellingTA": {
        "properties": {
          "L": {
            "type": "number",
            "title": "L"
          },
          "R": {
            "type": "number",
            "title": "R"
          }
        },
        "type": "object",
        "required": [
          "L",
          "R"
        ],
        "title": "CancellingTA"
      },
      "ChannelBank": {
        "properties": {
          "isLocked": {
            "type": "boolean",
            "title": "Islocked"
          },
          "numOfBand": {
            "type": "integer",
            "title": "Numofband"
          },
          "selectedBank": {
