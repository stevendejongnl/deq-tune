        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LRBank": {
        "properties": {
          "isLocked": {
            "type": "boolean",
            "title": "Islocked"
          },
          "numOfBand": {
            "type": "integer",
            "title": "Numofband"
          },
          "selectedBank": {
            "type": "integer",
            "title": "Selectedbank"
          },
          "banks": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Banks"
          }
        },
        "type": "object",
        "required": [
          "isLocked",
          "numOfBand",
          "selectedBank",
          "banks"
        ],
        "title": "LRBank",
        "description": "A combined L+R graphic-EQ slot. `banks` holds one 13-value gain\narray per storable bank (device has multiple slots); `selectedBank`\npicks which one is active. Frequencies follow the fixed 13-band\ntable also given explicitly per-channel in `expandEq` (50Hz-12.5kHz,\ndoubling)."
      },
      "ProfileCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "data": {
            "$ref": "#/components/schemas/TuningData"
          },
          "brand_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand Name"
          },
          "car_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
