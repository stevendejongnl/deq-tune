          "eqs": {
            "additionalProperties": {
              "$ref": "#/components/schemas/LRBank"
            },
            "type": "object",
            "title": "Eqs"
          },
          "expandEq": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ChannelBank"
            },
            "type": "object",
            "title": "Expandeq"
          }
        },
        "type": "object",
        "required": [
          "isLRMode",
          "eqs",
          "expandEq"
        ],
        "title": "FoundationEq"
      },
