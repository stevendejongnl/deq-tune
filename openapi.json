        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "brand_name",
          "car_model",
          "speaker_type",
          "supported_processors",
          "data"
        ],
        "title": "ProfileRead"
      },
      "ProfileUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
