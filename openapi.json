        "type": "object",
        "required": [
          "isLocked",
          "numOfBand",
          "selectedBank",
          "banks"
        ],
        "title": "ChannelBank"
      },
      "ChannelBankData": {
        "properties": {
          "q": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Q"
          },
          "f0": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "F0"
          },
          "gain": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Gain"
          }
        },
        "type": "object",
        "required": [
          "q",
          "f0",
          "gain"
        ],
        "title": "ChannelBankData"
      },
      "FactoryCancel": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "enabled": {
            "type": "boolean",
